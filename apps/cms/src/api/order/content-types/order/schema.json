{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "orderCode": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "customerName": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email"
    },
    "address": {
      "type": "text",
      "required": true
    },
    "city": {
      "type": "string",
      "required": true
    },
    "note": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "confirmed", "shipping", "completed", "cancelled"],
      "default": "pending",
      "required": true
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": ["cod"],
      "default": "cod",
      "required": true
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "order.order-item",
      "required": true
    },
    "subtotal": {
      "type": "decimal",
      "required": true
    },
    "shippingFee": {
      "type": "decimal",
      "required": true,
      "default": 0
    },
    "total": {
      "type": "decimal",
      "required": true
    }
  }
}
